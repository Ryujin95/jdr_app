APP_ENV=test
APP_DEBUG=1
KERNEL_CLASS='App\Kernel'
APP_SECRET=test-only-secret
DEFAULT_URI=http://localhost
DATABASE_URL=sqlite:///:memory:
MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=sync://
APP_STORAGE_DIR=%kernel.project_dir%/var/test
MAIL_FROM="JDR App Tests <test@example.invalid>"
APP_FROM_EMAIL="JDR App Tests <test@example.invalid>"
FRONT_BASE_URL="http://localhost"
CORS_ALLOW_ORIGIN_REGEX='^https?://(localhost|127\.0\.0\.1):5173$'
